# .env.example — copy to .env and adjust. NEVER commit the real .env.

# --- HTTP server ---------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000

# --- Storage -------------------------------------------------------------
# Any SQLAlchemy URL. The default keeps run history next to the code;
# in Docker this is pointed at the persisted volume instead.
# DATABASE_URL=sqlite:///./arcaptcha.db
# DATABASE_URL=sqlite:////data/arcaptcha.db          (inside Docker)
# DATABASE_URL=postgresql+psycopg://user:pass@db:5432/bots

# --- Execution -----------------------------------------------------------
# MAX_PARALLEL_RUNS=2
# RUN_TIMEOUT_SECONDS=300

# --- Browser -------------------------------------------------------------
# Leave empty to auto-detect. Inside Docker these are set by the image.
# CHROME_BINARY=/usr/bin/chromium
# CHROMEDRIVER_PATH=/usr/bin/chromedriver
# CHROME_NO_SANDBOX=false          # true inside containers
# WINDOW_WIDTH=1440
# WINDOW_HEIGHT=900

# --- Demo credentials (defaults: demo / demo) ----------------------------
# The demo site's own sample credentials. Configure per run in the web UI
# or bake defaults here:
# ARC_USERNAME=demo
# ARC_PASSWORD=demo


START_VNC=false

MAX_PARALLEL_RUNS=2
RUN_TIMEOUT_SECONDS=300
PAGE_LOAD_TIMEOUT=30

ARC_USERNAME=demo
ARC_PASSWORD=demo